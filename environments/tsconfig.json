{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "runtime-diff/*.ts",
    "meta-check/*.ts",
    "meta-check/*/*.ts"
  ],
  "exclude": [
    "meta-check/fixtures"
  ]
}
