{
  "name": "@pop-e2e/load-tests",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "clip": "ffmpeg -hide_banner -loglevel error -y -f lavfi -i 'testsrc2=size=360x360:rate=24,noise=alls=6:allf=t' -t 4 -pix_fmt yuv420p -c:v libx264 -profile:v baseline -level:v 3.1 -preset veryfast -b:v 300k -maxrate 330k -bufsize 165k -x264-params keyint=48:min-keyint=48:scenecut=0:repeat-headers=1:aud=1:slices=1:sliced-threads=0:rc-lookahead=0:sync-lookahead=0 -f h264 media/clip.h264",
    "light-slots": "light-slots/run.sh",
    "load": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@individuality/game-outcome": "*",
    "@individuality/people-chain": "*",
    "@jollity/collectables": "*",
    "@jollity/game-chain": "*",
    "@jollity/protocol": "*",
    "@jollity/statement-core": "*",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@parity/product-sdk-host": "0.31.0",
    "@parity/product-sdk-individuality": "0.11.4",
    "@parity/product-sdk-nfts": "0.4.1",
    "@polkadot-api/signers-common": "^0.4.0",
    "@polkadot-api/substrate-bindings": "^0.21.2",
    "@polkadot-api/utils": "^0.4.0",
    "@polkadot-labs/hdkd": "^0.0.32",
    "@polkadot-labs/hdkd-helpers": "^0.0.34",
    "@pop-e2e/chain-tests": "workspace:*",
    "@pop-e2e/papi": "workspace:*",
    "@scure/sr25519": "^2.4.0",
    "polkadot-api": "^3.3.0",
    "smoldot": "3.8.0",
    "werift": "0.28.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
