# Required: mnemonic for the funded test account (owns triangle-e2e.dot, funded on all chains)
TEST_MNEMONIC=

# Network to test against: paseo-next-v2 | previewnet (paseo-next v1 sunset)
NETWORK=paseo-next-v2

# Optional: shared HS256 secret for IB's verifyJwt middleware. When set,
# `/api/v1/*` calls (attester, register, prefix-search) carry a Bearer
# token signed with this secret. Required once the target IB has
# JWT_AUTH_ENFORCED=true. Leave unset to send no Authorization header.
IB_JWT_SECRET=
