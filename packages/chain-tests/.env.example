# Required: mnemonic for the funded test account (owns triangle-e2e.dot, funded on all chains)
TEST_MNEMONIC=

# Network to test against: paseo-next-v2 | previewnet | devnet (paseo-next v1 sunset)
NETWORK=paseo-next-v2

# Optional: run against another instance of the network, such as a fork or staging, by its
# Trinity stack descriptor URL or polkadotapp://stack link. NETWORK defaults to the stack's.
# STACK=https://previewnet-stg.substrate.dev/.well-known/trinity-stack.json
