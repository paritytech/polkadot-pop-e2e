# Required: mnemonic for the funded test account (owns triangle-e2e.dot, funded on all chains)
TEST_MNEMONIC=

# Network to test against: paseo-next-v2 (default) | previewnet | devnet (paseo-next v1 sunset)
# NETWORK=paseo-next-v2

# Optional: run against another stack, such as a fork, by its Trinity stack descriptor URL or
# stack link. Without NETWORK, the network is the one the stack is an instance or a fork of.
# STACK=http://127.0.0.1:8090/.well-known/trinity-stack.json
