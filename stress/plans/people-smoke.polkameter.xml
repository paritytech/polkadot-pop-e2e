<?xml version="1.0" encoding="UTF-8"?>
<polkameter-plan xmlns="https://polkameter.dev/schema/plan" version="1" name="people-smoke" mode="smoke" timeout-ms="7200000">
  <plugins><plugin id="people" version="0.1.0" protocol="1"/></plugins>
  <targets>
    <target id="people" endpoint="ws://127.0.0.1:10010"/>
    <target id="relay" endpoint="ws://127.0.0.1:10000"/>
  </targets>
  <credentials><credential id="admin" profile="previewnet-sudo"/></credentials>
  <preflight><step id="compatibility" use="people.preflight"><input name="target" ref="targets.people"/></step></preflight>
  <setup>
    <step id="recognition" use="people.recognize">
      <input name="target" ref="targets.people"/>
      <input name="credential" ref="credentials.admin"/>
      <input name="members" value="40"/>
    </step>
    <step id="recognized" use="core.submit-setup" timeout-ms="1200000">
      <input name="target" ref="targets.people"/>
      <input name="transactions" ref="steps.recognition.transactions"/>
    </step>
    <step id="claims" use="people.prepare-claims" timeout-ms="3600000">
      <input name="target" ref="targets.people"/>
      <input name="members" ref="steps.recognition.members"/>
      <input name="slots" value="12"/>
      <input name="probe-reserve" ref="run.probeBudget"/>
    </step>
    <step id="fresh" use="people.validate-prepared">
      <input name="target" ref="targets.people"/>
      <input name="identity" ref="steps.claims.identity"/>
    </step>
    <step id="recycler" use="people.recycler-start">
      <input name="target" ref="targets.people"/>
    </step>
  </setup>
  <load target="people" source-ref="steps.claims.flood" probes-ref="steps.claims.probes" state-check="people.check-state" state-ref="steps.claims.state" connections="4" baseline-probes="3" recovery-seconds="120" block-interval-seconds="6">
    <rate tx-per-second="2" seconds="30"/>
    <rate tx-per-second="4" seconds="30"/>
    <rate tx-per-second="6" seconds="30"/>
  </load>
  <monitors topology="previewnet" relay-target="relay" para-id="1502">
    <metric role="collator" name="substrate_block_height"/>
    <metric role="validator" name="substrate_block_height"/>
  </monitors>
  <thresholds stall-ms="30000" finality-stall-ms="60000"/>
  <evaluate>
    <step id="recycler-stopped" use="people.recycler-stop" timeout-ms="240000">
      <input name="drain-ms" value="180000"/>
    </step>
    <step id="recycler-checks" use="people.recycler-checks" timeout-ms="120000">
      <input name="run-dir" ref="run.directory"/>
      <input name="problems" ref="steps.recycler-stopped.problems"/>
    </step>
  </evaluate>
</polkameter-plan>
