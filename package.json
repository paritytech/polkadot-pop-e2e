{
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "postinstall": "pnpm --filter @pop-e2e/papi generate",
    "test:environments": "node --test environments/*.test.mjs && node --import tsx --test environments/runtime-diff/*.test.ts",
    "resolve:environment": "node environments/resolve.mjs",
    "scan:baseline": "node environments/baseline-scan.mjs",
    "typecheck:environments": "tsc -p environments"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "@individuality/game-outcome": "github:paritytech/individuality-apps#2560663a232cb710b10b7f5417fc300cd830efbe&path:/packages/individuality-game-outcome",
      "@individuality/name-link": "github:paritytech/individuality-apps#2560663a232cb710b10b7f5417fc300cd830efbe&path:/packages/individuality-name-link",
      "@individuality/people-chain": "github:paritytech/individuality-apps#2560663a232cb710b10b7f5417fc300cd830efbe&path:/packages/individuality-people-chain",
      "@individuality/prize": "github:paritytech/individuality-apps#2560663a232cb710b10b7f5417fc300cd830efbe&path:/packages/individuality-prize",
      "@individuality/shared-records": "github:paritytech/individuality-apps#2560663a232cb710b10b7f5417fc300cd830efbe&path:/packages/shared-records",
      "@individuality/sign-up": "github:paritytech/individuality-apps#2560663a232cb710b10b7f5417fc300cd830efbe&path:/packages/individuality-sign-up",
      "@jollity/collectables": "github:paritytech/individuality-apps#2560663a232cb710b10b7f5417fc300cd830efbe&path:/packages/jollity-collectables",
      "@jollity/game-chain": "github:paritytech/individuality-apps#2560663a232cb710b10b7f5417fc300cd830efbe&path:/packages/jollity-game-chain",
      "@jollity/protocol": "github:paritytech/individuality-apps#2560663a232cb710b10b7f5417fc300cd830efbe&path:/packages/jollity-protocol",
      "@jollity/statement-core": "github:paritytech/individuality-apps#2560663a232cb710b10b7f5417fc300cd830efbe&path:/packages/jollity-statement-core",
      "@polkadot-api/json-rpc-provider": "^0.2.0"
    }
  },
  "devDependencies": {
    "@polkadot-api/metadata-builders": "^0.15.2",
    "@polkadot-api/metadata-compatibility": "^0.7.2",
    "@polkadot-api/substrate-bindings": "^0.21.2",
    "@polkadot-api/wasm-executor": "^0.2.3",
    "@types/node": "^26.6.6",
